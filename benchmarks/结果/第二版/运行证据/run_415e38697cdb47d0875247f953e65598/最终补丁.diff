+<!DOCTYPE html>
+<html lang="zh-CN">
+<head>
+  <meta charset="UTF-8" />
+  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
+  <title>EvoShop - Sign in</title>
+  <style>
+    * { box-sizing: border-box; margin: 0; padding: 0; }
+    body {
+      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
+      background-color: #f4f6fb;
+      color: #1f2a44;
+      min-height: 100vh;
+    }
+    .navbar {
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      padding: 24px 48px;
+      background-color: #142352;
+      color: #ffffff;
+    }
+    .navbar .brand {
+      font-size: 36px;
+      font-weight: 600;
+      letter-spacing: 0.5px;
+    }
+    .navbar nav a {
+      color: #e6ebf7;
+      text-decoration: none;
+      margin-left: 24px;
+      font-size: 20px;
+    }
+    .navbar nav a:hover { text-decoration: underline; }
+    .page {
+      display: flex;
+      align-items: center;
+      justify-content: center;
+      padding: 48px 24px;
+      gap: 32px;
+      flex-wrap: wrap;
+    }
+    .discount-badge {
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      justify-content: center;
+      width: 200px;
+      height: 220px;
+      background-color: #fff9e8;
+      border: 3px solid #f59e0b;
+      border-radius: 24px;
+      color: #92400e;
+      text-align: center;
+      padding: 16px;
+    }
+    .discount-badge .icon {
+      width: 64px;
+      height: 64px;
+      border-radius: 50%;
+      background-color: #f59e0b;
+      color: #ffffff;
+      display: flex;
+      align-items: center;
+      justify-content: center;
+      font-size: 32px;
+      font-weight: 700;
+      margin-bottom: 16px;
+    }
+    .discount-badge .label {
+      font-size: 22px;
+      font-weight: 600;
+      line-height: 1.3;
+    }
+    .login-card {
+      background-color: #ffffff;
+      border: 2px solid #d8dee9;
+      border-radius: 24px;
+      padding: 48px 56px;
+      width: 100%;
+      max-width: 560px;
+      box-shadow: 0 4px 16px rgba(20, 35, 82, 0.04);
+    }
+    .login-card h1 {
+      font-size: 44px;
+      color: #142352;
+      margin-bottom: 12px;
+    }
+    .login-card .subtitle {
+      font-size: 22px;
+      color: #6b7691;
+      margin-bottom: 32px;
+    }
+    .form-group {
+      margin-bottom: 24px;
+    }
+    .form-group label {
+      display: block;
+      font-size: 18px;
+      color: #374151;
+      margin-bottom: 10px;
+      font-weight: 500;
+    }
+    .form-group input {
+      width: 100%;
+      padding: 16px 20px;
+      font-size: 18px;
+      border: 1.5px solid #9aa5b8;
+      border-radius: 10px;
+      background-color: #f8fafc;
+      color: #1f2a44;
+      outline: none;
+      transition: border-color 0.15s ease, box-shadow 0.15s ease;
+    }
+    .form-group input:focus {
+      border-color: #2563eb;
+      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
+      background-color: #ffffff;
+    }
+    .discount-login-hint {
+      margin: 8px 0 24px;
+      padding: 14px 18px;
+      background-color: #fff7ed;
+      border: 1px solid #fdba74;
+      border-left: 4px solid #f59e0b;
+      border-radius: 8px;
+      color: #92400e;
+      font-size: 16px;
+      line-height: 1.5;
+    }
+    .signin-btn {
+      width: 100%;
+      padding: 16px;
+      font-size: 20px;
+      font-weight: 600;
+      color: #ffffff;
+      background-color: #2563eb;
+      border: none;
+      border-radius: 12px;
+      cursor: pointer;
+      transition: background-color 0.15s ease;
+    }
+    .signin-btn:hover {
+      background-color: #1d4ed8;
+    }
+    .requirement-note {
+      background-color: #eff6ff;
+      border: 2px solid #60a5fa;
+      border-radius: 20px;
+      padding: 24px 28px;
+      max-width: 280px;
+      color: #1e3a8a;
+    }
+    .requirement-note h3 {
+      font-size: 22px;
+      font-weight: 500;
+      margin-bottom: 16px;
+    }
+    .requirement-note p {
+      font-size: 19px;
+      line-height: 1.5;
+    }
+  </style>
+</head>
+<body>
+  <header class="navbar">
+    <div class="brand">EvoShop</div>
+    <nav>
+      <a href="#products">Products</a>
+      <a href="#help">Help</a>
+    </nav>
+  </header>
+
+  <main class="page">
+    <aside class="discount-badge" aria-hidden="true">
+      <div class="icon">%</div>
+      <div class="label">Exclusive<br />discount</div>
+    </aside>
+
+    <section class="login-card">
+      <h1>Welcome back</h1>
+      <p class="subtitle">Sign in to continue</p>
+
+      <div data-testid="discount-login-hint" class="discount-login-hint" role="note">
+        登录后可查看专属折扣
+      </div>
+
+      <form id="login-form" novalidate>
+        <div class="form-group">
+          <label for="email">Email</label>
+          <input
+            type="email"
+            id="email"
+            name="email"
+            placeholder="member@example.com"
+            autocomplete="email"
+            required
+          />
+        </div>
+
+        <div class="form-group">
+          <label for="password">Password</label>
+          <input
+            type="password"
+            id="password"
+            name="password"
+            placeholder="************"
+            autocomplete="current-password"
+            required
+          />
+        </div>
+
+        <button type="submit" class="signin-btn">Sign in</button>
+      </form>
+    </section>
+
+    <aside class="requirement-note">
+      <h3>UI requirement</h3>
+      <p>Show a login hint for member-only discounts.</p>
+    </aside>
+  </main>
+</body>
+</html>

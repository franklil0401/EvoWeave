diff --git a/web/login.html b/web/login.html
new file mode 100644
index 0000000000000000000000000000000000000000..f8167fc18ebf604f7bd8f72aa6678c4ee996a7c4
--- /dev/null
+++ b/web/login.html
@@ -0,0 +1,254 @@
+<!DOCTYPE html>
+<html lang="zh-CN">
+<head>
+  <meta charset="UTF-8" />
+  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
+  <title>EvoShop - Sign in</title>
+  <style>
+    * { box-sizing: border-box; margin: 0; padding: 0; }
+    body {
+      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
+      background-color: #f4f6fb;
+      color: #1f2937;
+      min-height: 100vh;
+    }
+    .navbar {
+      display: flex;
+      align-items: center;
+      justify-content: space-between;
+      padding: 24px 48px;
+      background-color: #142555;
+      color: #ffffff;
+    }
+    .navbar .brand {
+      font-size: 40px;
+      font-weight: 600;
+      letter-spacing: 0.5px;
+    }
+    .navbar nav a {
+      color: #e2e8f0;
+      text-decoration: none;
+      margin-left: 24px;
+      font-size: 22px;
+    }
+    .navbar nav a:hover { color: #ffffff; }
+    .page {
+      display: flex;
+      align-items: center;
+      justify-content: center;
+      padding: 48px 24px;
+      gap: 48px;
+      flex-wrap: wrap;
+    }
+    .discount-badge {
+      display: flex;
+      flex-direction: column;
+      align-items: center;
+      justify-content: center;
+      width: 200px;
+      height: 240px;
+      background-color: #fff9e6;
+      border: 4px solid #f59e0b;
+      border-radius: 28px;
+      color: #92400e;
+      position: relative;
+    }
+    .discount-badge .percent {
+      width: 72px;
+      height: 72px;
+      border-radius: 50%;
+      background-color: #f59e0b;
+      color: #ffffff;
+      font-size: 36px;
+      font-weight: 700;
+      display: flex;
+      align-items: center;
+      justify-content: center;
+      margin-bottom: 16px;
+    }
+    .discount-badge .label {
+      font-size: 24px;
+      font-weight: 600;
+      text-align: center;
+      line-height: 1.3;
+    }
+    .discount-badge::after {
+      content: "";
+      position: absolute;
+      right: -40px;
+      top: 50%;
+      width: 32px;
+      height: 4px;
+      background-color: #f59e0b;
+      transform: translateY(-50%);
+    }
+    .discount-badge::before {
+      content: "";
+      position: absolute;
+      right: -48px;
+      top: calc(50% - 8px);
+      width: 0;
+      height: 0;
+      border-top: 10px solid transparent;
+      border-bottom: 10px solid transparent;
+      border-left: 14px solid #f59e0b;
+      transform: translateY(-50%);
+    }
+    .login-card {
+      background-color: #ffffff;
+      border: 2px solid #d7deea;
+      border-radius: 28px;
+      padding: 48px 56px;
+      width: 100%;
+      max-width: 620px;
+      box-shadow: 0 4px 16px rgba(20, 37, 85, 0.04);
+    }
+    .login-card h1 {
+      font-size: 48px;
+      color: #142555;
+      margin-bottom: 12px;
+      font-weight: 600;
+    }
+    .login-card .subtitle {
+      font-size: 24px;
+      color: #64748b;
+      margin-bottom: 36px;
+    }
+    .form-group {
+      margin-bottom: 24px;
+    }
+    .form-group label {
+      display: block;
+      font-size: 20px;
+      color: #334155;
+      margin-bottom: 10px;
+      font-weight: 500;
+    }
+    .form-group input {
+      width: 100%;
+      padding: 18px 20px;
+      font-size: 20px;
+      border: 2px solid #94a3b8;
+      border-radius: 12px;
+      background-color: #f8fafc;
+      color: #1f2937;
+      outline: none;
+      transition: border-color 0.15s ease, box-shadow 0.15s ease;
+    }
+    .form-group input:focus {
+      border-color: #2563eb;
+      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
+      background-color: #ffffff;
+    }
+    .discount-login-hint {
+      margin: 8px 0 28px;
+      padding: 14px 18px;
+      background-color: #eff6ff;
+      border: 1px solid #bfdbfe;
+      border-left: 4px solid #2563eb;
+      border-radius: 10px;
+      color: #1e3a8a;
+      font-size: 16px;
+      line-height: 1.5;
+    }
+    .signin-btn {
+      width: 100%;
+      padding: 18px;
+      font-size: 22px;
+      font-weight: 600;
+      color: #ffffff;
+      background-color: #2563eb;
+      border: none;
+      border-radius: 14px;
+      cursor: pointer;
+      transition: background-color 0.15s ease;
+    }
+    .signin-btn:hover {
+      background-color: #1d4ed8;
+    }
+    .requirement-note {
+      background-color: #eff6ff;
+      border: 2px solid #60a5fa;
+      border-radius: 24px;
+      padding: 28px 32px;
+      max-width: 280px;
+      color: #1e3a8a;
+    }
+    .requirement-note h2 {
+      font-size: 24px;
+      font-weight: 600;
+      margin-bottom: 20px;
+    }
+    .requirement-note p {
+      font-size: 22px;
+      line-height: 1.5;
+      color: #1d4ed8;
+    }
+    @media (max-width: 1100px) {
+      .discount-badge::after,
+      .discount-badge::before { display: none; }
+    }
+  </style>
+</head>
+<body>
+  <header class="navbar">
+    <div class="brand">EvoShop</div>
+    <nav>
+      <a href="#products">Products</a>
+      <a href="#help">Help</a>
+    </nav>
+  </header>
+
+  <main class="page">
+    <aside class="discount-badge" aria-hidden="true">
+      <div class="percent">%</div>
+      <div class="label">Exclusive<br />discount</div>
+    </aside>
+
+    <section class="login-card">
+      <h1>Welcome back</h1>
+      <p class="subtitle">Sign in to continue</p>
+
+      <form method="post" action="/login" novalidate>
+        <div class="form-group">
+          <label for="email">Email</label>
+          <input
+            type="email"
+            id="email"
+            name="email"
+            placeholder="member@example.com"
+            autocomplete="email"
+          />
+        </div>
+
+        <div class="form-group">
+          <label for="password">Password</label>
+          <input
+            type="password"
+            id="password"
+            name="password"
+            placeholder="************"
+            autocomplete="current-password"
+          />
+        </div>
+
+        <div
+          id="discount-login-hint"
+          class="discount-login-hint"
+          data-testid="discount-login-hint"
+          role="note"
+        >
+          登录后可查看专属折扣
+        </div>
+
+        <button type="submit" class="signin-btn">Sign in</button>
+      </form>
+    </section>
+
+    <aside class="requirement-note">
+      <h2>UI requirement</h2>
+      <p>Show a login hint for member-only discounts.</p>
+    </aside>
+  </main>
+</body>
+</html>
